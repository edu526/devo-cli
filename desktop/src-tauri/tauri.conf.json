{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Devo",
  "mainBinaryName": "devo-desktop",
  "version": "0.1.0-alpha.3",
  "identifier": "dev.heyedu.devo",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm kill-zombies && pnpm dev",
    "beforeBuildCommand": "pnpm kill-zombies && pnpm build"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Secure AWS bastion tunnels, database connections, and SSO profile management",
    "longDescription": "Devo is a desktop companion for the devo CLI. It manages secure SSM port-forwarding tunnels to private databases through AWS bastion hosts, keeps AWS SSO profiles authenticated, and gives you a GUI over EC2 instances, database connections, and /etc/hosts entries used for tunneling.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/devo-sidecar"],
    "linux": {
      "deb": {
        "section": "net"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2ODFCOTM3Njg1QzBFNEYKUldSUERseG9ON21CaHNIQkx1YTdsNDhMUTAyUnJWYlBST2FoWmFFZENva1NGT2l3eW9qVzBPLzgK",
      "endpoints": ["https://github.com/edu526/devo-cli/releases/download/app-alpha/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "Devo",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#0f0f0f"
      }
    ],
    "security": {
      "csp": null
    }
  }
}
